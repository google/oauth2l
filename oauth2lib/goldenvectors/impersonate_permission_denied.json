{
  "name": "impersonate_permission_denied",
  "description": "IAM refuses: the source lacks roles/iam.serviceAccountTokenCreator. An IAM google.rpc.Status error is KindUnknown (fails fast, no sentinel); only OAuth access_denied is KindAccessDenied.",
  "python": "google/auth/impersonated_credentials.py _make_iam_token_request",
  "input": {
    "impersonation": {
      "source": {
        "credentials_json": {
          "type": "authorized_user",
          "client_id": "client-id.apps.googleusercontent.com",
          "client_secret": "fake-client-secret",
          "refresh_token": "fake-refresh-token"
        }
      },
      "target": "target@project.iam.gserviceaccount.com",
      "scopes": [
        "https://www.googleapis.com/auth/cloud-platform"
      ]
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "client_id": "client-id.apps.googleusercontent.com",
          "client_secret": "fake-client-secret",
          "refresh_token": "fake-refresh-token"
        }
      },
      "response": {
        "body": {
          "access_token": "fake-source-token",
          "expires_in": 3600,
          "token_type": "Bearer"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://iamcredentials.googleapis.com/v1/projects/-/serviceAccounts/target@project.iam.gserviceaccount.com:generateAccessToken",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer fake-source-token"
        },
        "json": {
          "delegates": null,
          "scope": [
            "https://www.googleapis.com/auth/cloud-platform"
          ],
          "lifetime": "3600s"
        }
      },
      "response": {
        "status": 403,
        "body": {
          "error": {
            "code": 403,
            "status": "PERMISSION_DENIED",
            "message": "Permission 'iam.serviceAccounts.getAccessToken' denied"
          }
        }
      }
    }
  ],
  "expected": {
    "error": {
      "kind": "unknown",
      "code": "PERMISSION_DENIED",
      "description": "Permission 'iam.serviceAccounts.getAccessToken' denied",
      "status_code": 403
    },
    "universe_domain": "googleapis.com"
  }
}
