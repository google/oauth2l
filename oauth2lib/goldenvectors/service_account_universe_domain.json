{
  "name": "service_account_universe_domain",
  "description": "A service_account key in universe example.com without use_self_signed_jwt: there is no JWT bearer grant (2LO) outside googleapis.com, so it signs its own JWT with the scopes and sends no request, as google-auth and Python gcloud do.",
  "python": "google/oauth2/service_account.py Credentials.__init__ (always_use_jwt_access outside the default universe); googlecloudsdk/core/credentials/creds.py UseSelfSignedJwt",
  "input": {
    "config": {
      "credentials_json": {
        "type": "service_account",
        "project_id": "project",
        "private_key_id": "key-id-1",
        "private_key": "TEST_PRIVATE_KEY_PEM",
        "client_email": "sa@project.iam.gserviceaccount.com",
        "client_id": "123",
        "token_uri": "https://oauth2.example.com/token",
        "universe_domain": "example.com"
      },
      "scopes": [
        "https://www.googleapis.com/auth/cloud-platform"
      ]
    }
  },
  "exchanges": [],
  "expected": {
    "token": {
      "jwt": {
        "header": {
          "alg": "RS256",
          "typ": "JWT",
          "kid": "key-id-1"
        },
        "claims": {
          "iss": "sa@project.iam.gserviceaccount.com",
          "sub": "sa@project.iam.gserviceaccount.com",
          "scope": "https://www.googleapis.com/auth/cloud-platform"
        },
        "lifetime_seconds": 3600
      },
      "type": "Bearer",
      "expires_in_seconds": 3600,
      "metadata": {}
    },
    "universe_domain": "example.com"
  }
}
