{
  "name": "impersonate_source_reauth",
  "description": "A source that needs reauth fails before IAM is called, with the source's error.",
  "python": "googlecloudsdk/core/credentials/google_auth_credentials.py _RefreshGrant; google/oauth2/_client.py refresh_grant",
  "input": {
    "impersonation": {
      "source": {
        "credentials_json": {
          "type": "authorized_user",
          "client_id": "client-id.apps.googleusercontent.com",
          "client_secret": "fake-client-secret",
          "refresh_token": "fake-refresh-token"
        }
      },
      "target": "target@project.iam.gserviceaccount.com",
      "scopes": [
        "https://www.googleapis.com/auth/cloud-platform"
      ]
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "client_id": "client-id.apps.googleusercontent.com",
          "client_secret": "fake-client-secret",
          "refresh_token": "fake-refresh-token"
        }
      },
      "response": {
        "status": 400,
        "body": {
          "error": "invalid_grant",
          "error_subtype": "rapt_required",
          "error_description": "Reauthentication is needed."
        }
      }
    }
  ],
  "expected": {
    "error": {
      "kind": "reauth required",
      "code": "invalid_grant",
      "subtype": "rapt_required",
      "description": "Reauthentication is needed.",
      "status_code": 400,
      "is": [
        "ErrReauthRequired"
      ]
    },
    "universe_domain": "googleapis.com"
  }
}
