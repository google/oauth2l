{
  "name": "impersonate_delegates_lifetime",
  "description": "Impersonate with a delegation chain (two hops) and a 600s lifetime.",
  "python": "google/auth/impersonated_credentials.py _make_iam_token_request",
  "input": {
    "impersonation": {
      "source": {
        "credentials_json": {
          "type": "authorized_user",
          "client_id": "client-id.apps.googleusercontent.com",
          "client_secret": "fake-client-secret",
          "refresh_token": "fake-refresh-token"
        }
      },
      "target": "target@project.iam.gserviceaccount.com",
      "delegates": [
        "hop1@project.iam.gserviceaccount.com"
      ],
      "scopes": [
        "https://www.googleapis.com/auth/cloud-platform"
      ],
      "lifetime_seconds": 600
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "client_id": "client-id.apps.googleusercontent.com",
          "client_secret": "fake-client-secret",
          "refresh_token": "fake-refresh-token"
        }
      },
      "response": {
        "body": {
          "access_token": "fake-source-token",
          "expires_in": 3600,
          "token_type": "Bearer"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://iamcredentials.googleapis.com/v1/projects/-/serviceAccounts/target@project.iam.gserviceaccount.com:generateAccessToken",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer fake-source-token"
        },
        "json": {
          "delegates": [
            "hop1@project.iam.gserviceaccount.com"
          ],
          "scope": [
            "https://www.googleapis.com/auth/cloud-platform"
          ],
          "lifetime": "600s"
        }
      },
      "response": {
        "body": {
          "accessToken": "fake-impersonated-token",
          "expireTime": "2030-01-02T03:04:05Z"
        }
      }
    }
  ],
  "expected": {
    "token": {
      "value": "fake-impersonated-token",
      "type": "Bearer",
      "expiry": "2030-01-02T03:04:05Z",
      "metadata": {}
    },
    "universe_domain": "googleapis.com"
  }
}
