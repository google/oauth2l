{
  "name": "user_client_timeout",
  "description": "http.Client.Timeout expires before the token endpoint answers. That is transient, and the error does not match context.DeadlineExceeded, since the caller's context did not end.",
  "python": "googlecloudsdk/core/credentials/google_auth_credentials.py _RefreshGrant; google/oauth2/_client.py refresh_grant",
  "input": {
    "config": {
      "credentials_json": {
        "type": "authorized_user",
        "client_id": "client-id.apps.googleusercontent.com",
        "client_secret": "fake-client-secret",
        "refresh_token": "fake-refresh-token"
      }
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "client_id": "client-id.apps.googleusercontent.com",
          "client_secret": "fake-client-secret",
          "refresh_token": "fake-refresh-token"
        }
      },
      "response": {
        "transport_error": {
          "message": "Client.Timeout exceeded while awaiting headers",
          "type": "client_timeout"
        }
      }
    }
  ],
  "expected": {
    "error": {
      "kind": "transient",
      "is": [
        "ErrTransient"
      ]
    },
    "universe_domain": "googleapis.com"
  }
}
