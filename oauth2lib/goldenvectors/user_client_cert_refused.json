{
  "name": "user_client_cert_refused",
  "description": "The client's certificate callback or signer refuses to provide a client certificate (its error wraps ErrAccessDenied, for example the enterprise certificate proxy refusing an untrusted device). That is access denied, not transient, so it is not retried.",
  "python": "googlecloudsdk/core/credentials/google_auth_credentials.py _RefreshGrant; google/oauth2/_client.py refresh_grant",
  "input": {
    "config": {
      "credentials_json": {
        "type": "authorized_user",
        "client_id": "client-id.apps.googleusercontent.com",
        "client_secret": "fake-client-secret",
        "refresh_token": "fake-refresh-token"
      }
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "client_id": "client-id.apps.googleusercontent.com",
          "client_secret": "fake-client-secret",
          "refresh_token": "fake-refresh-token"
        }
      },
      "response": {
        "transport_error": {
          "message": "certificate provider refused to sign: device is not trusted",
          "type": "client_cert_refused"
        }
      }
    }
  ],
  "expected": {
    "error": {
      "kind": "access_denied",
      "is": [
        "ErrAccessDenied"
      ]
    },
    "universe_domain": "googleapis.com"
  }
}
