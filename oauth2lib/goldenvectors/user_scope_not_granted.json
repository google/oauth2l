{
  "name": "user_scope_not_granted",
  "description": "A granted scope list that misses a requested scope fails, as Python gcloud's _Refresh does.",
  "python": "googlecloudsdk/core/credentials/google_auth_credentials.py _RefreshGrant; google/oauth2/_client.py refresh_grant",
  "input": {
    "config": {
      "credentials_json": {
        "type": "authorized_user",
        "client_id": "client-id.apps.googleusercontent.com",
        "client_secret": "fake-client-secret",
        "refresh_token": "fake-refresh-token"
      },
      "scopes": [
        "https://www.googleapis.com/auth/cloud-platform",
        "openid"
      ]
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "client_id": "client-id.apps.googleusercontent.com",
          "client_secret": "fake-client-secret",
          "refresh_token": "fake-refresh-token",
          "scope": "https://www.googleapis.com/auth/cloud-platform openid"
        }
      },
      "response": {
        "body": {
          "access_token": "fake-access-token",
          "expires_in": 3600,
          "token_type": "Bearer",
          "scope": "https://www.googleapis.com/auth/cloud-platform"
        }
      }
    }
  ],
  "expected": {
    "error": {
      "kind": "invalid grant",
      "status_code": 200,
      "description": "Not all requested scopes were granted by the authorization server, missing scopes openid.",
      "is": [
        "ErrInvalidGrant"
      ]
    },
    "universe_domain": "googleapis.com"
  }
}
