{
  "name": "user_refresh_scopes_rapt",
  "description": "Scopes and a RAPT are sent; the response rotates the refresh token, returns an ID token and grants every scope. Metadata reports the new refresh token, the ID token and the RAPT sent.",
  "python": "googlecloudsdk/core/credentials/google_auth_credentials.py _RefreshGrant; google/oauth2/_client.py refresh_grant",
  "input": {
    "config": {
      "credentials_json": {
        "type": "authorized_user",
        "client_id": "client-id.apps.googleusercontent.com",
        "client_secret": "fake-client-secret",
        "refresh_token": "fake-refresh-token"
      },
      "scopes": [
        "https://www.googleapis.com/auth/cloud-platform",
        "openid"
      ],
      "rapt": "fake-rapt-token"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "client_id": "client-id.apps.googleusercontent.com",
          "client_secret": "fake-client-secret",
          "refresh_token": "fake-refresh-token",
          "scope": "https://www.googleapis.com/auth/cloud-platform openid",
          "rapt": "fake-rapt-token"
        }
      },
      "response": {
        "body": {
          "access_token": "fake-access-token",
          "expires_in": 3600,
          "token_type": "Bearer",
          "refresh_token": "fake-rotated-refresh-token",
          "id_token": "fake-id-token",
          "scope": "openid https://www.googleapis.com/auth/cloud-platform"
        }
      }
    }
  ],
  "expected": {
    "token": {
      "value": "fake-access-token",
      "type": "Bearer",
      "metadata": {
        "refresh_token": "fake-rotated-refresh-token",
        "id_token": "fake-id-token",
        "rapt_token": "fake-rapt-token"
      },
      "expires_in_seconds": 3600
    },
    "universe_domain": "googleapis.com"
  }
}
