{
  "name": "impersonated_json_user_source",
  "description": "impersonated_service_account JSON with an authorized_user source: refresh, then IAM generateAccessToken with the source token.",
  "python": "googlecloudsdk/core/credentials/google_auth_credentials.py _RefreshGrant; google/oauth2/_client.py refresh_grant; google/auth/impersonated_credentials.py _make_iam_token_request",
  "input": {
    "config": {
      "credentials_json": {
        "type": "impersonated_service_account",
        "service_account_impersonation_url": "https://iamcredentials.googleapis.com/v1/projects/-/serviceAccounts/target@project.iam.gserviceaccount.com:generateAccessToken",
        "source_credentials": {
          "type": "authorized_user",
          "client_id": "client-id.apps.googleusercontent.com",
          "client_secret": "fake-client-secret",
          "refresh_token": "fake-refresh-token"
        },
        "delegates": [],
        "scopes": [
          "https://www.googleapis.com/auth/cloud-platform"
        ]
      }
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "client_id": "client-id.apps.googleusercontent.com",
          "client_secret": "fake-client-secret",
          "refresh_token": "fake-refresh-token"
        }
      },
      "response": {
        "body": {
          "access_token": "fake-source-token",
          "expires_in": 3600,
          "token_type": "Bearer"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://iamcredentials.googleapis.com/v1/projects/-/serviceAccounts/target@project.iam.gserviceaccount.com:generateAccessToken",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer fake-source-token"
        },
        "json": {
          "delegates": null,
          "scope": [
            "https://www.googleapis.com/auth/cloud-platform"
          ],
          "lifetime": "3600s"
        }
      },
      "response": {
        "body": {
          "accessToken": "fake-impersonated-token",
          "expireTime": "2030-01-02T03:04:05Z"
        }
      }
    }
  ],
  "expected": {
    "token": {
      "value": "fake-impersonated-token",
      "type": "Bearer",
      "expiry": "2030-01-02T03:04:05Z",
      "metadata": {}
    },
    "universe_domain": "googleapis.com"
  }
}
