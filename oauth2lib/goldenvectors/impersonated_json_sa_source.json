{
  "name": "impersonated_json_sa_source",
  "description": "A service_account source gets the IAM scope, as google-auth gives it. The file's \"delegates\": [] is sent to IAM as null; Python sends [] (README: Known differences from Python).",
  "python": "google/oauth2/service_account.py Credentials._make_authorization_grant_assertion; google/auth/impersonated_credentials.py _make_iam_token_request",
  "input": {
    "config": {
      "credentials_json": {
        "type": "impersonated_service_account",
        "service_account_impersonation_url": "https://iamcredentials.googleapis.com/v1/projects/-/serviceAccounts/target@project.iam.gserviceaccount.com:generateAccessToken",
        "source_credentials": {
          "type": "service_account",
          "project_id": "project",
          "private_key_id": "key-id-1",
          "private_key": "TEST_PRIVATE_KEY_PEM",
          "client_email": "sa@project.iam.gserviceaccount.com",
          "client_id": "123",
          "token_uri": "https://oauth2.googleapis.com/token"
        },
        "delegates": [],
        "scopes": [
          "https://www.googleapis.com/auth/cloud-platform"
        ]
      },
      "scopes": [
        "https://www.googleapis.com/auth/userinfo.email"
      ]
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer"
        },
        "assertion": {
          "header": {
            "alg": "RS256",
            "typ": "JWT",
            "kid": "key-id-1"
          },
          "claims": {
            "iss": "sa@project.iam.gserviceaccount.com",
            "aud": "https://oauth2.googleapis.com/token",
            "scope": "https://www.googleapis.com/auth/iam"
          },
          "absent_claims": [
            "sub"
          ],
          "lifetime_seconds": 3600
        }
      },
      "response": {
        "body": {
          "access_token": "fake-source-token",
          "expires_in": 3600,
          "token_type": "Bearer"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://iamcredentials.googleapis.com/v1/projects/-/serviceAccounts/target@project.iam.gserviceaccount.com:generateAccessToken",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer fake-source-token"
        },
        "json": {
          "delegates": null,
          "scope": [
            "https://www.googleapis.com/auth/userinfo.email"
          ],
          "lifetime": "3600s"
        }
      },
      "response": {
        "body": {
          "accessToken": "fake-impersonated-token",
          "expireTime": "2030-01-02T03:04:05Z"
        }
      }
    }
  ],
  "expected": {
    "token": {
      "value": "fake-impersonated-token",
      "type": "Bearer",
      "expiry": "2030-01-02T03:04:05Z",
      "metadata": {}
    },
    "universe_domain": "googleapis.com"
  }
}
